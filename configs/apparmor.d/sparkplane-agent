#include <tunables/global>

profile sparkplane-agent /opt/sparkplane/current/sparkplane flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  /opt/sparkplane/releases/*/sparkplane mr,
  /opt/sparkplane/releases/*/minisign.pub r,
  /opt/sparkplane/hf-http-fallback/*/venv/bin/python* ixr,
  /opt/sparkplane/hf-http-fallback/*/venv/bin/huggingface-cli ixr,
  /opt/sparkplane/hf-http-fallback/*/venv/bin/ r,
  /opt/sparkplane/hf-http-fallback/*/venv/pyvenv.cfg r,
  /opt/sparkplane/hf-http-fallback/*/venv/lib/** mr,
  /etc/sparkplane/agent.toml r,
  /etc/sparkplane/models.toml r,
  /etc/sparkplane/engines/ r,
  /etc/sparkplane/engines/*.toml r,
  deny /etc/sparkplane/** wklx,
  /var/lib/sparkplane/ r,
  /var/lib/sparkplane/state.sqlite3* rwk,
  /var/lib/sparkplane/backups/ rw,
  /var/lib/sparkplane/backups/** rwk,
  /var/lib/sparkplane/huggingface/ rw,
  /var/lib/sparkplane/huggingface/** rwk,
  /var/lib/sparkplane/tls/ r,
  /var/lib/sparkplane/tls/** r,
  /run/credentials/sparkplane-agent.service/ r,
  /run/credentials/sparkplane-agent.service/bootstrap-token r,
  /run/credentials/sparkplane-agent.service/hf-token r,
  /run/systemd/notify w,
  /run/sparkplane/executor.sock rw,
  /proc/meminfo r,
  /proc/*/cgroup r,
  /proc/pressure/ r,
  /proc/pressure/** r,
  /proc/self/ r,
  /proc/self/** r,
  /sys/fs/cgroup/** r,
  /tmp/ rw,
  /tmp/** rwkl,
  /dev/shm/sem.* rwkl,

  network inet stream,
  network inet6 stream,
  network unix stream,
  network unix dgram,

  deny /var/run/docker.sock rw,
  deny /run/docker.sock rw,
  deny /var/lib/sparkplane/ca/** rwklx,
  deny /var/lib/sparkplane/executor/** rwklx,
  deny /var/lib/sparkplane/compile-cache/** rwklx,
  deny /home/** rwklx,
}
