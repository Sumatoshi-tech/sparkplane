[Unit]
Description=Sparkplane DGX Spark root executor
After=docker.service
Wants=docker.service
Before=sparkplane-agent.service
PartOf=sparkplane.target
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=notify
User=root
Group=sparkplane
ExecStart=/opt/sparkplane/current/sparkplane executor run-executor --config /etc/sparkplane/executor.toml
WorkingDirectory=/var/lib/sparkplane/executor
UMask=0007
RuntimeDirectory=sparkplane
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=no
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=default
ProtectSystem=strict
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
DevicePolicy=closed
ReadOnlyPaths=/etc/sparkplane/executor.toml /etc/sparkplane/agent.toml /etc/sparkplane/engines /var/lib/sparkplane/huggingface
ReadWritePaths=/run/sparkplane /var/run/docker.sock /var/lib/sparkplane/executor /var/lib/sparkplane/compile-cache /sys/fs/cgroup/system.slice
LimitNOFILE=4096
TasksMax=64
MemoryMax=64M
OOMScoreAdjust=-250
AppArmorProfile=sparkplane-executor
NotifyAccess=main
WatchdogSec=30s
TimeoutStopSec=15s
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sparkplane.target
